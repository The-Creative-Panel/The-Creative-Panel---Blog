---
// /social's own navbar: it's the one landing page for everything shared on social media, so it
// gets a slim bar of its own instead of the full site menu. Logo, a greeting for the platform the
// visitor came from, a few useful links, and one clear way into the full blog.
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-brand-ink/95 text-white backdrop-blur">
	<div class="flex w-full items-center justify-between gap-4 px-5 py-3 lg:px-10">
		<a href="/" class="font-logo text-[18px] font-bold uppercase tracking-tight !text-brand-gold no-underline">
			The Creative Panel<span class="text-brand-logo-accent">.</span>
		</a>
		<p class="label !m-0 hidden !text-[13px] text-white/60 md:block" data-from="Welcome, {p} readers">Welcome, reader</p>
		<nav class="flex items-center gap-5 text-[14px]" aria-label="Main">
			<a href="/latest/" class="hidden !text-white/75 no-underline hover:!text-brand-gold sm:inline">Latest</a>
			<a href="/books/" class="hidden !text-white/75 no-underline hover:!text-brand-gold sm:inline">Books</a>
			<a href="/about/" class="hidden !text-white/75 no-underline hover:!text-brand-gold sm:inline">About</a>
			<a href="/" class="label border border-brand-gold/60 px-3 py-1.5 !text-[13px] !text-brand-gold no-underline hover:bg-brand-gold hover:!text-black">Read the blog →</a>
		</nav>
	</div>
</header>

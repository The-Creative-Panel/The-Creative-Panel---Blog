---
// Newsletter lab A · Simple: one centered column. Promise + form first, then what you get, then proof (recent posts).
import JoinForm from '../../newsletter/JoinForm.astro';
import PostImage from '../../PostImage.astro';
import { formatDate, type Post } from '../../../lib/posts';
import type { NewsletterLabData } from './types';
interface Props extends NewsletterLabData {}
const { recent, schedule, perks, pitch } = Astro.props;
---

<main class="page-narrow mx-auto w-full pb-20 pt-12 md:pt-16">
	<section class="text-center">
		<p class="label !mb-3 !text-[16px] font-semibold text-primary">The Newsletter</p>
		<h1 class="mx-auto max-w-2xl font-display !text-[44px] font-semibold uppercase !leading-[0.95] md:!text-[60px]">Get every new post in your inbox</h1>
		<p class="mx-auto mt-4 max-w-xl text-[18px] text-muted-foreground">{pitch}</p>
		<div class="mx-auto mt-8 max-w-lg text-left">
			<JoinForm id="nl-a" />
		</div>
	</section>

	<section class="mt-16 border-t border-border pt-10" aria-labelledby="nl-a-get">
		<h2 id="nl-a-get" class="label !mb-6 text-center !text-[15px] text-muted-foreground">What you'll get</h2>
		<ul class="grid gap-8 !p-0 sm:grid-cols-3">
			{
				perks.map((p) => (
					<li class="list-none text-center">
						<span class="mx-auto mb-3 grid h-11 w-11 place-items-center rounded-full bg-primary/10 text-primary" set:html={p.icon} />
						<p class="!mb-1 font-heading text-[19px] font-semibold">{p.title}</p>
						<p class="!m-0 text-[16px] text-muted-foreground">{p.text}</p>
					</li>
				))
			}
		</ul>
		<p class="!mb-0 mt-8 text-center text-[16px] text-muted-foreground">
			New posts <strong class="text-foreground">{schedule.daysLabel}</strong> at {schedule.timeLabel}.
		</p>
	</section>

	<section class="mt-16 border-t border-border pt-10" aria-labelledby="nl-a-recent">
		<h2 id="nl-a-recent" class="label !mb-6 text-center !text-[15px] text-muted-foreground">Recently sent</h2>
		<ul class="grid gap-6 !p-0 sm:grid-cols-3">
			{
				recent.slice(0, 3).map((p: Post) => (
					<li class="list-none">
						<a href={`/blog/${p.id}/`} class="group block !text-foreground no-underline">
							<PostImage src={p.data.heroImage} fallback={p.data.category ?? ''} alt="" width={400} class="aspect-[4/3] w-full !rounded-none object-cover" />
							<p class="!mb-1 mt-3 font-heading text-[18px] font-semibold !leading-snug group-hover:text-primary">{p.data.title}</p>
							<time class="text-[14px] uppercase tracking-[0.08em] text-muted-foreground" datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</main>

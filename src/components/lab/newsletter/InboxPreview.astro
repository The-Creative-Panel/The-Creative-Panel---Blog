---
// Newsletter lab B · Inbox preview: a gold signup panel beside a mock-up of the email a subscriber
// gets when a post goes out (built from the latest real post), so readers see exactly what they sign up for.
import JoinForm from '../../newsletter/JoinForm.astro';
import PostImage from '../../PostImage.astro';
import { SITE_TIMEZONE } from '../../../consts';
import type { NewsletterLabData } from './types';
interface Props extends NewsletterLabData {}
const { latest, schedule, perks, pitch } = Astro.props;
// When the latest post actually went out, in Joel's time zone, like an inbox shows it: "Fri, Nov 13"
const sentLabel = latest.data.pubDate.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: SITE_TIMEZONE });
---

<main class="!m-0 w-full !max-w-none !p-0">
	<div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
		<!-- Signup -->
		<section class="flex flex-col justify-center bg-brand-gold px-6 py-12 text-black sm:px-10 lg:px-14 lg:py-20 2xl:px-20">
			<p class="label !mb-3 !text-[14px] text-black/70">The Creative Panel · Newsletter</p>
			<h1 class="!m-0 max-w-xl font-display !text-[44px] font-semibold uppercase !leading-[0.92] text-black md:!text-[64px] 2xl:!text-[76px]">Join the panel</h1>
			<p class="!mb-8 mt-4 max-w-md text-[18px] text-black/75">{pitch}</p>
			<div class="max-w-md">
				<JoinForm id="nl-b" tone="gold" button="Join free" />
			</div>
			<p class="!mb-0 mt-8 max-w-md border-t border-black/15 pt-4 text-[15px] text-black/70">
				Lands {schedule.daysLabel} at {schedule.timeLabel}.
			</p>
		</section>

		<!-- What it looks like: an email mock-up -->
		<section class="flex items-center justify-center bg-muted px-4 py-12 sm:px-10 lg:py-20" aria-label="What the email looks like">
			<figure class="!m-0 w-full max-w-md">
				<figcaption class="label !mb-3 text-center !text-[13px] text-muted-foreground">What lands in your inbox</figcaption>
				<div class="overflow-hidden rounded-lg border border-border bg-background shadow-xl">
					<div class="flex items-center gap-3 border-b border-border px-4 py-3">
						<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-black font-display text-[15px] font-semibold text-brand-gold" aria-hidden="true">JG</span>
						<div class="min-w-0 flex-1">
							<p class="!m-0 text-[14px] font-semibold text-foreground">Joel Green</p>
							<p class="!m-0 truncate text-[13px] text-muted-foreground">New post: {latest.data.title}</p>
						</div>
						<time class="shrink-0 text-[12px] text-muted-foreground" datetime={latest.data.pubDate.toISOString()}>{sentLabel}</time>
					</div>
					<div class="p-5">
						<PostImage src={latest.data.heroImage} fallback={latest.data.category ?? ''} alt="" width={500} class="aspect-[16/9] w-full !rounded-none object-cover" />
						<p class="label !mb-1 mt-4 !text-[12px] text-primary">{latest.data.category}</p>
						<p class="!mb-2 font-heading text-[20px] font-semibold !leading-snug text-foreground">{latest.data.title}</p>
						{latest.data.description && <p class="!mb-4 line-clamp-3 text-[15px] text-muted-foreground">{latest.data.description}</p>}
						<a href={`/blog/${latest.id}/`} class="label inline-block bg-black px-4 py-2.5 !text-[13px] !font-semibold !text-brand-gold no-underline hover:opacity-90">Read the full post →</a>
					</div>
				</div>
			</figure>
		</section>
	</div>

	<!-- What you get -->
	<section class="page-wide mx-auto w-full py-14" aria-labelledby="nl-b-get">
		<h2 id="nl-b-get" class="label !mb-8 !text-[15px] text-muted-foreground">Every issue</h2>
		<ul class="grid gap-8 !p-0 md:grid-cols-3">
			{
				perks.map((p, i) => (
					<li class="list-none border-t-2 border-foreground pt-4">
						<p class="!mb-1 font-display text-[15px] font-semibold text-primary">0{i + 1}</p>
						<p class="!mb-1 font-heading text-[20px] font-semibold">{p.title}</p>
						<p class="!m-0 text-[16px] text-muted-foreground">{p.text}</p>
					</li>
				))
			}
		</ul>
	</section>
</main>

---
// Newsletter lab C · Follow the book: The Halo's live word count is the hook ("watch it get written"),
// on black like the author site, with the signup right under it and recent posts as proof.
import JoinForm from '../../newsletter/JoinForm.astro';
import { formatDate, type Post } from '../../../lib/posts';
import type { NewsletterLabData } from './types';
interface Props extends NewsletterLabData {}
const { recent, book, schedule, perks, pitch } = Astro.props;

const count = book?.data.wordCount ?? 0;
const target = book?.data.targetWordCount || 80000;
const pct = Math.min(100, (count / target) * 100);
const updated = book?.data.wordCountUpdatedAt
	? book.data.wordCountUpdatedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' })
	: '';
---

<main class="!m-0 w-full !max-w-none !p-0">
	<section class="bg-black px-6 py-14 text-white sm:px-10 md:py-20">
		<div class="mx-auto max-w-3xl">
			<p class="label !mb-3 !text-[14px] text-brand-gold">The Newsletter</p>
			<h1 class="!m-0 font-display !text-[42px] font-semibold uppercase !leading-[0.95] !text-white md:!text-[64px]">
				Follow {book?.data.title ?? 'the book'} as it's written
			</h1>
			<p class="!mb-0 mt-4 max-w-xl text-[18px] text-white/70">{pitch}</p>

			{
				book && (
					<div class="mt-10" aria-label={`Writing progress: ${count.toLocaleString()} of ${target.toLocaleString()} words`}>
						<div class="mb-2 flex items-baseline justify-between gap-4">
							<span class="label !text-[13px] text-white/50">{book.data.series ?? 'Writing progress'}</span>
							<span class="font-display text-[28px] font-semibold text-brand-teal">
								{count.toLocaleString()} <span class="text-[15px] text-white/50">/ {target.toLocaleString()} words</span>
							</span>
						</div>
						<div class="h-1.5 w-full bg-white/10">
							<div class="h-1.5 bg-brand-teal" style={`width: ${pct.toFixed(2)}%`} />
						</div>
						{updated && <p class="!mb-0 mt-2 text-[13px] text-white/40">Updated {updated}</p>}
					</div>
				)
			}

			<div class="mt-10 max-w-lg">
				<JoinForm id="nl-c" tone="dark" button="Follow along" />
			</div>
		</div>
	</section>

	<section class="mx-auto grid max-w-5xl gap-12 px-6 py-14 sm:px-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
		<div>
			<h2 class="label !mb-5 !text-[15px] text-muted-foreground">In every issue</h2>
			<ul class="space-y-5 !p-0">
				{
					perks.map((p) => (
						<li class="flex list-none gap-3">
							<span class="mt-0.5 shrink-0 text-primary" set:html={p.icon} />
							<div>
								<p class="!mb-0.5 font-heading text-[18px] font-semibold">{p.title}</p>
								<p class="!m-0 text-[16px] text-muted-foreground">{p.text}</p>
							</div>
						</li>
					))
				}
			</ul>
			<p class="!mb-0 mt-6 text-[15px] text-muted-foreground">{schedule.daysLabel} at {schedule.timeLabel}.</p>
		</div>
		<div>
			<h2 class="label !mb-5 !text-[15px] text-muted-foreground">Recent issues</h2>
			<ol class="!p-0">
				{
					recent.slice(0, 3).map((p: Post) => (
						<li class="list-none border-b border-border">
							<a href={`/blog/${p.id}/`} class="group flex items-baseline justify-between gap-4 py-4 !text-foreground no-underline">
								<span class="font-heading text-[18px] font-semibold !leading-snug group-hover:text-primary">{p.data.title}</span>
								<time class="shrink-0 text-[13px] uppercase tracking-[0.08em] text-muted-foreground" datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>
</main>

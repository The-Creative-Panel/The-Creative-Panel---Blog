---
// Slim welcome bar under the site header, for visitors from a social link: greets them by
// platform and points to where to start. Used by the "Front page" design.
import type { SocialPageProps } from '../../social/types';
const { schedule } = Astro.props as Pick<SocialPageProps, 'schedule'>;
---

<div class="border-b border-border bg-card">
	<div class="page-wide flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-3 text-[15px]">
		<p class="!m-0"><span class="font-semibold" data-from="Welcome, {p} readers.">Welcome.</span> <span class="text-muted-foreground">New posts {schedule.daysLabel} at {schedule.timeLabel}.</span></p>
		<p class="!m-0 text-muted-foreground"><a href="/about/">Who's writing this?</a> · <a href="/latest/">Latest posts</a></p>
	</div>
</div>

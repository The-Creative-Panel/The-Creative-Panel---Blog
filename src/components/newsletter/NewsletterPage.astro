---
// The /newsletter page body (chosen from the lab: src/pages/lab/newsletter, design D).
// The newsletter is ONE EMAIL A MONTH (not one per post), so the preview is a monthly roundup.
//   1. Gold newsletter hero (the page's only form).
//   2. Two cards side by side: the monthly email (built from this month's real posts) and The Halo's live word count.
//   3. Every issue: the three perks.
//   4. Recent posts: the next few that aren't already in the email preview.
import type { CollectionEntry } from 'astro:content';
import { SITE_TIMEZONE } from '../../consts';
import type { Perk } from '../../data/newsletter';
import { formatDate, type Post } from '../../lib/posts';
import PostImage from '../PostImage.astro';
import JoinForm from './JoinForm.astro';

interface Props {
	/** All posts, newest first */
	posts: Post[];
	book?: CollectionEntry<'books'>;
	pitch: string;
	perks: Perk[];
}
const { posts, book, perks, pitch } = Astro.props;

// The email preview: the month of the newest post, with that month's real posts (in Joel's time zone)
const monthKey = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: SITE_TIMEZONE }); // "November 2026"
const latest = posts[0];
const month = monthKey(latest.data.pubDate);
const monthPosts = posts.filter((p) => monthKey(p.data.pubDate) === month);
const inEmail = monthPosts.slice(0, 3);
const moreInMonth = monthPosts.length - inEmail.length;
const monthName = month.split(' ')[0]; // "November"
// Recent posts below: the next ones that aren't already in the email preview
const more = posts.filter((p) => !inEmail.includes(p)).slice(0, 3);

const count = book?.data.wordCount ?? 0;
const target = book?.data.targetWordCount || 80000;
const pct = Math.min(100, (count / target) * 100);
const updated = book?.data.wordCountUpdatedAt
	? book.data.wordCountUpdatedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: SITE_TIMEZONE })
	: '';
---

<main class="!m-0 w-full !max-w-none !p-0">
	<!-- 1. Newsletter hero -->
	<section class="relative flex min-h-[calc(100svh-57px)] items-center overflow-hidden bg-brand-gold px-6 py-16 text-black sm:px-10 md:min-h-[68vh] lg:py-24">
		<!-- The favicon's mark (public/favicon.svg: a "C" in a panel + the logo's square dot), oversized and faint -->
		<svg class="pointer-events-none absolute -bottom-[12%] -right-[8%] h-auto w-[95vw] select-none text-black/[0.07] sm:w-[70vw] md:-bottom-[18%] md:w-[52vw]" viewBox="5 9 54 46" aria-hidden="true">
			<rect x="9" y="13" width="36" height="38" rx="2.5" fill="none" stroke="currentColor" stroke-width="4" />
			<text x="27" y="43" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="29" fill="currentColor">C</text>
			<rect x="49.5" y="43.5" width="7" height="7" fill="currentColor" />
		</svg>
		<div class="relative mx-auto flex w-full max-w-4xl flex-col items-center text-center">
			<p class="label !mb-4 !text-[14px] text-black/70 md:!text-[15px]">The Creative Panel · Newsletter</p>
			<h1 class="!m-0 font-display !text-[60px] font-semibold uppercase !leading-[0.88] tracking-[-0.01em] text-black sm:!text-[84px] lg:!text-[104px] 2xl:!text-[124px]">Join the panel</h1>
			<p class="!mb-0 mt-5 max-w-xl text-[18px] text-black/75 md:text-[21px]">{pitch}</p>
			<div class="mt-9 w-full max-w-lg text-left">
				<JoinForm id="nl-d-top" tone="gold" button="Join free" />
			</div>
		</div>
	</section>

	<!-- 2. The monthly email + book update -->
	<section class="flex flex-col items-center justify-center gap-8 bg-muted px-4 py-12 sm:px-10 md:flex-row md:items-stretch lg:py-16" aria-label="What you get">
			<figure class="!m-0 flex w-full max-w-md flex-col">
				<figcaption class="label !mb-3 text-center !text-[13px] text-muted-foreground">What lands in your inbox each month</figcaption>
				<div class="flex-1 overflow-hidden rounded-lg border border-border bg-background shadow-xl">
					<div class="flex items-center gap-3 border-b border-border px-4 py-3">
						<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-black font-display text-[15px] font-semibold text-brand-gold" aria-hidden="true">JG</span>
						<div class="min-w-0 flex-1">
							<p class="!m-0 text-[14px] font-semibold text-foreground">Joel Green</p>
							<p class="!m-0 truncate text-[13px] text-muted-foreground">The Creative Panel · {monthName}</p>
						</div>
						<span class="shrink-0 text-[12px] text-muted-foreground">Monthly</span>
					</div>
					<div class="p-5">
						<PostImage src={latest.data.heroImage} fallback={latest.data.category ?? ''} alt="" width={500} class="aspect-[16/9] w-full !rounded-none object-cover" />
						<p class="label !mb-3 mt-4 !text-[12px] text-primary">This month on the panel</p>
						<ul class="!mb-4 space-y-2.5 !p-0">
							{
								inEmail.map((p) => (
									<li class="list-none border-b border-border pb-2.5 last:border-0 last:pb-0">
										<a href={`/blog/${p.id}/`} class="group block !text-foreground no-underline">
											<span class="label block !text-[11px] text-muted-foreground">{p.data.category}</span>
											<span class="font-heading text-[17px] font-semibold !leading-snug group-hover:text-primary">{p.data.title}</span>
										</a>
									</li>
								))
							}
						</ul>
						{moreInMonth > 0 && <p class="!mb-4 text-[14px] text-muted-foreground">+ {moreInMonth} more {moreInMonth === 1 ? 'post' : 'posts'} this month</p>}
						<a href="/latest/" class="label inline-block bg-black px-4 py-2.5 !text-[13px] !font-semibold !text-brand-gold no-underline hover:opacity-90">Read them on the blog →</a>
					</div>
				</div>
			</figure>
			{
				book && (
					<figure class="!m-0 flex w-full max-w-md flex-col">
						<figcaption class="label !mb-3 text-center !text-[13px] text-muted-foreground">And behind the scenes</figcaption>
						<div class="flex flex-1 flex-col justify-center rounded-lg bg-black p-7 text-white shadow-xl sm:p-8" aria-label={`Writing progress on ${book.data.title}: ${count.toLocaleString()} of ${target.toLocaleString()} words`}>
							<p class="label !mb-2 !text-[13px] text-brand-gold">{book.data.series ?? 'Writing progress'}</p>
							<p class="!m-0 font-display text-[34px] font-semibold uppercase !leading-[0.95] text-white 2xl:text-[42px]">Follow {book.data.title} as it's written</p>
							<p class="!mb-0 mt-8 font-display text-[28px] font-semibold text-brand-teal">
								{count.toLocaleString()} <span class="text-[15px] text-white/50">/ {target.toLocaleString()} words</span>
							</p>
							<div class="mt-2 h-1.5 w-full bg-white/10">
								<div class="h-1.5 bg-brand-teal" style={`width: ${pct.toFixed(2)}%`} />
							</div>
							{updated && <p class="!mb-0 mt-2 text-[13px] text-white/40">Updated {updated}</p>}
						</div>
					</figure>
				)
			}
	</section>

	<!-- 3. Every issue -->
	<section class="page-wide mx-auto w-full pt-14" aria-labelledby="nl-d-get">
		<div>
			<h2 id="nl-d-get" class="label !mb-6 !text-[15px] text-muted-foreground">Every issue</h2>
			<ul class="grid gap-8 !p-0 md:grid-cols-3">
				{
					perks.map((p) => (
						<li class="flex list-none gap-4">
							<span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-primary/10 text-primary" set:html={p.icon} />
							<div>
								<p class="!mb-0.5 font-heading text-[19px] font-semibold">{p.title}</p>
								<p class="!m-0 text-[16px] text-muted-foreground">{p.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>
	<!-- 4. Recent posts -->
	<section class="page-wide mx-auto w-full py-14" aria-labelledby="nl-d-recent">
		<h2 id="nl-d-recent" class="label !mb-8 !text-[15px] text-muted-foreground">Recent posts</h2>
		<ul class="grid gap-8 !p-0 sm:grid-cols-3">
			{
				more.map((p: Post) => (
					<li class="list-none">
						<a href={`/blog/${p.id}/`} class="group block !text-foreground no-underline">
							<PostImage src={p.data.heroImage} fallback={p.data.category ?? ''} alt="" width={480} class="aspect-[4/3] w-full !rounded-none object-cover" />
							<p class="label !mb-1 mt-4 !text-[12px] text-primary">{p.data.category}</p>
							<p class="!mb-1 font-heading text-[19px] font-semibold !leading-snug group-hover:text-primary">{p.data.title}</p>
							<time class="text-[14px] uppercase tracking-[0.08em] text-muted-foreground" datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
						</a>
					</li>
				))
			}
		</ul>
	</section>

</main>

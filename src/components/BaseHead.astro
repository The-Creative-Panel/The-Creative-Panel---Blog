---
// Everything in <head>: styles, fonts, theme, and all the SEO tags.
// Import the global.css file here so that it is included on all pages.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import { graph } from '../lib/seo';

interface Props {
	/** Full page title, e.g. "Archive — The Creative Panel" (keep under ~60 characters) */
	title: string;
	/** Search-result snippet (aim for 120–160 characters) */
	description: string;
	/** Share image: a local image file, or a full URL (posts from the admin). Defaults to the branded card. */
	image?: ImageMetadata | string;
	imageAlt?: string;
	/** "article" for blog posts (adds published/modified dates and tags) */
	type?: 'website' | 'article';
	article?: { published: Date; modified?: Date; section?: string; tags?: string[] };
	/** Keep this page out of search results (legal pages, 404) */
	noindex?: boolean;
	/** Extra schema.org nodes for this page (added to the site + author graph) */
	schema?: object[];
}

const { title, description, image, imageAlt, type = 'website', article, noindex = false, schema = [] } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const gtmId = import.meta.env.PUBLIC_GTM_ID;

// Canonical: always the production URL with a trailing slash (matches the built folders),
// so search engines see one URL per page
const path = Astro.url.pathname.endsWith('/') || /\.[a-z0-9]+$/i.test(Astro.url.pathname) ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(path, Astro.site);

const ogImage = image ? new URL(typeof image === 'string' ? image : image.src, Astro.site) : new URL('/og-default.png', Astro.site);
const ogImageSize = image ? (typeof image === 'string' ? null : { width: image.width, height: image.height }) : { width: 1200, height: 630 };
const ogImageAlt = imageAlt ?? (image ? title : `${SITE_TITLE} — The Writings of Joel Green`);
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
// "<" escaped so text like "</script>" in a post title can't break out of the tag
const jsonLd = noindex ? null : JSON.stringify(graph(...schema)).replace(/</g, '\\u003c');
---

<!-- Apply saved dark/light theme before the page paints (prevents a flash).
     is:inline = Astro leaves this script exactly as written, in place. -->
<script is:inline>
	if (localStorage.getItem("theme") === "dark") document.documentElement.classList.add("dark");
</script>
<!-- Cookie consent (Google Consent Mode v2). Runs before AdSense and Tag Manager so they start with
     the right permissions. The banner that changes them is src/components/CookieConsent.astro.
       - EEA, UK, Switzerland: analytics + personalized ads stay off until the visitor opts in
       - everywhere else: on, until the visitor opts out (or their browser sends Global Privacy Control) -->
<script is:inline>
	(function () {
		window.dataLayer = window.dataLayer || [];
		window.gtag = window.gtag || function () { dataLayer.push(arguments); };
		var on = function (b) { return b ? "granted" : "denied"; };
		var gpc = navigator.globalPrivacyControl === true;
		var optIn = ["AT","BE","BG","HR","CY","CZ","DK","EE","FI","FR","DE","GR","HU","IS","IE","IT","LV","LI","LT","LU","MT","NL","NO","PL","PT","RO","SK","SI","ES","SE","GB","CH"];
		gtag("consent", "default", { ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", analytics_storage: "denied", region: optIn, wait_for_update: 500 });
		gtag("consent", "default", { ad_storage: "granted", ad_user_data: on(!gpc), ad_personalization: on(!gpc), analytics_storage: "granted" });
		var choice = null;
		try { choice = JSON.parse(localStorage.getItem("cookieConsent") || "null"); } catch (e) {}
		if (choice) gtag("consent", "update", { analytics_storage: on(choice.analytics), ad_storage: on(choice.ads), ad_user_data: on(choice.ads), ad_personalization: on(choice.ads) });
	})();
</script>
<!-- Owner's devices: open any page with ?dontcount and this device stops counting post views
     (src/lib/reactions.ts); ?count turns counting back on. -->
<script is:inline>
	(function () {
		var q = new URLSearchParams(location.search);
		var off = q.has("dontcount"), on = q.has("count");
		if (!off && !on) return;
		try {
			if (off) localStorage.setItem("noViewCount", "1");
			else localStorage.removeItem("noViewCount");
		} catch (e) { return; }
		q.delete("dontcount");
		q.delete("count");
		history.replaceState(null, "", location.pathname + (q.toString() ? "?" + q : "") + location.hash);
		addEventListener("DOMContentLoaded", function () {
			var n = document.createElement("div");
			n.setAttribute("role", "status");
			n.textContent = off ? "This device won't count post views." : "This device counts post views again.";
			n.style.cssText = "position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;background:#111;color:#fff;padding:10px 16px;font:500 14px/1.3 system-ui,sans-serif;border-radius:6px;box-shadow:0 4px 16px rgba(0,0,0,.3)";
			document.body.appendChild(n);
			setTimeout(function () { n.remove(); }, 4000);
		});
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0b0b0b" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />

<!-- Preload only what paints first (display titles + body text); other weights load on demand -->
<Font cssVariable="--font-barlow-condensed" preload={[{ subset: "latin", weight: 600, style: "normal" }]} />
<Font cssVariable="--font-barlow" />
<Font cssVariable="--font-inter" preload={[{ subset: "latin", weight: 400, style: "normal" }]} />

<!-- Google AdSense loader (only once a publisher ID is configured; see AdSlot.astro) -->
{
	adsenseClient && (
		<script
			is:inline
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
			crossorigin="anonymous"
		/>
	)
}

<!-- Google Tag Manager (only once a container ID is configured). The tags themselves
     (Analytics etc.) are set up in tagmanager.google.com, not here. -->
{
	gtmId && (
		<>
			<script is:inline define:vars={{ gtmId }}>
				// Only the live site reports to Analytics: local copies, previews and the design lab
				// (localhost, workers.dev) would otherwise show up as real visits.
				if (/(^|\.)joelgreen\.studio$/.test(location.hostname)) {
					// dataLayer + gtag() were set up by the consent script above
					gtag("js", new Date());
					// The start event GTM's "All pages" trigger listens for
					dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
					var s = document.createElement("script");
					s.async = true;
					s.src = "https://www.googletagmanager.com/gtm.js?id=" + gtmId;
					document.head.appendChild(s);
				}
			</script>
		</>
	)
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Joel Green" />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph (Facebook, LinkedIn, iMessage, Discord…) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
{ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
{ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
{
	article && (
		<>
			<meta property="article:published_time" content={article.published.toISOString()} />
			<meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />
			<meta property="article:author" content="https://joelgreen.studio/about/" />
			{article.section && <meta property="article:section" content={article.section} />}
			{article.tags?.map((t) => <meta property="article:tag" content={t} />)}
		</>
	)
}

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Structured data (schema.org): site, author, and this page (src/lib/seo.ts) -->
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

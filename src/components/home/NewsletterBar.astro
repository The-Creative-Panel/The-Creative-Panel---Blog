---
// Newsletter signup. Posts to services/api `/subscribers`.
// Set PUBLIC_API_URL (e.g. in apps/blog/.env) to the deployed API's URL.
import { NEWSLETTER_PITCH } from '../../consts';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? '';
---

<section class="border-b border-border bg-card" data-newsletter-root>
	<div class="mx-auto flex max-w-[77rem] flex-col gap-4 px-4 py-6 sm:px-6 md:flex-row md:items-start md:justify-between lg:px-9">
		<div class="flex items-start gap-3">
			<svg class="mt-1 h-5 w-5 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
				><rect x="3" y="5" width="18" height="14" rx="1"></rect><path d="m3 7 9 6 9-6"></path></svg
			>
			<div>
				<p class="label !mb-1 !text-[16px] !font-medium text-foreground">The Newsletter</p>
				<p class="!m-0 text-[16px] text-muted-foreground">{NEWSLETTER_PITCH}</p>
			</div>
		</div>

		<div class="w-full md:w-auto">
			<form class="newsletter flex w-full" data-newsletter data-api={apiUrl}>
				<label for="nl-email" class="sr-only">Email address</label>
				<input
					id="nl-email"
					type="email"
					name="email"
					required
					placeholder="your@email.com"
					class="w-full min-w-0 border border-input bg-muted px-4 py-3 text-sm outline-none focus:border-primary md:w-72"
				/>
				<button type="submit" class="label shrink-0 bg-primary px-5 !text-[16px] !font-semibold text-primary-foreground hover:opacity-90">
					Subscribe
				</button>
			</form>
			<!-- Under the form: the privacy note, replaced by the result message after submitting -->
			<p class="peer !mb-0 mt-2 text-[16px]" data-newsletter-status role="status" hidden></p>
			<p class="!mb-0 mt-2 text-[16px] text-muted-foreground peer-[:not([hidden])]:hidden">
				Unsubscribe anytime. See the <a href="/privacy" class="!text-muted-foreground underline hover:!text-primary">Privacy Policy</a>.
			</p>
		</div>
	</div>
</section>

<script>
	import { initNewsletterForms } from '../../lib/newsletter';
	initNewsletterForms();
</script>

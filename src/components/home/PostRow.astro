---
import PostImage from '../PostImage.astro';
import type { Post } from '../../lib/posts';
import PostMeta from './PostMeta.astro';

// One item in the "Latest" list. data-tags is read by the tag filter script.
interface Props {
	post: Post;
}
const { post } = Astro.props;
const { title, heroImage, tags } = post.data;
---

<li class="post-row list-none border-b border-border py-5 first:pt-0 last:border-b-0" data-tags={tags.join(' ')}>
	<a href={`/blog/${post.id}/`} class="group flex gap-4 !text-foreground no-underline">
		<PostImage fallback={post.data.category ?? ''} src={heroImage} alt="" width={240} class="h-[72px] w-24 shrink-0 !rounded-none object-cover sm:h-24 sm:w-32" />
		<div class="min-w-0">
			<p class="!mb-1 font-display text-[10px] font-bold uppercase tracking-[0.1em] text-primary [word-spacing:0.35em]">
				{tags.slice(0, 3).map((t) => `#${t}`).join(' ')}
			</p>
			<h3 class="!mb-1.5 font-heading !text-[16px] font-medium !leading-snug group-hover:text-primary">{title}</h3>
			<PostMeta post={post} class="text-muted-foreground" />
		</div>
	</a>
</li>

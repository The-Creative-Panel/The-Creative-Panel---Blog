---
// Desktop bar under the article (prototype): "Did you enjoy this piece?" ♥ N … Save · Share [link] [X]
// Phones get PostActionBar instead. Both share state through src/lib/reactions.ts.
interface Props {
	postId: string;
	title: string;
	url: string;
	/** Like count from the API, once it exists. 0 for now. */
	likeCount?: number;
}
import { taggedUrl } from '../../lib/viewSource';
const { postId, title, url, likeCount = 0 } = Astro.props;
// Share links carry UTM tags (src/lib/viewSource.ts), so views from them show by source in the admin
const tweetUrl = `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(taggedUrl(url, 'x'))}`;
const copyUrl = taggedUrl(url, 'copied-link');
---

<div class="post-reactions mt-12 hidden items-center justify-between gap-6 border-t border-border pt-10 md:flex" data-post-id={postId} data-url={copyUrl} data-likes={likeCount}>
	<div class="flex items-center gap-5">
		<p class="!m-0 text-[16px] text-muted-foreground">Did you enjoy this piece?</p>
		<button type="button" class="like-btn" data-like aria-pressed="false" aria-label="Like this post">
			<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
				><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.6 4.5 7.1 4.5c2 0 3.6 1.1 4.9 2.8 1.3-1.7 2.9-2.8 4.9-2.8 3.5 0 5.7 3.5 4.4 6.8-1.8 4.6-9.3 9.2-9.3 9.2z"></path></svg
			>
			<span data-like-count>{likeCount}</span>
		</button>
	</div>

	<div class="flex items-center gap-5">
		<button type="button" class="save-btn" data-save aria-pressed="false">
			<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3.5h12v17l-6-4-6 4z"></path></svg>
			<span data-save-label>Save</span>
		</button>
		<span class="font-display text-[16px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">Share</span>
		<div class="flex items-center gap-2">
			<button type="button" class="square-btn" data-copy aria-label="Copy link" title="Copy link">
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
					><path d="M9 17H7a5 5 0 0 1 0-10h2M15 7h2a5 5 0 0 1 0 10h-2M8 12h8"></path></svg
				>
			</button>
			<a href={tweetUrl} target="_blank" rel="noopener" class="square-btn" aria-label="Share on X" title="Share on X">
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"
					><path d="M22 4.5s-.9 2-2.4 3c.5 9.5-10.3 14.9-17.1 9.6 2.6.2 4.6-.6 6.1-2-4.6-.4-6.1-4.6-5.3-7.4.9.6 1.9.9 2.6.9C3.6 6.9 3.9 3.6 5.4 2.9 7.6 5.6 10.6 7.2 13.9 7.3 13.3 4 16.3 1.8 19 3.3c1 .2 2-.3 3-.8z"></path></svg
				>
			</a>
		</div>
	</div>
</div>

<script>
	import { copyLink, isOn, likeCount, onChange, startPost, toggle } from '../../lib/reactions';

	const bar = document.querySelector<HTMLElement>('.post-reactions');
	if (bar) {
		const id = bar.dataset.postId!;
		const base = Number(bar.dataset.likes ?? 0);
		const likeBtn = bar.querySelector<HTMLButtonElement>('[data-like]')!;
		const saveBtn = bar.querySelector<HTMLButtonElement>('[data-save]')!;
		const copyBtn = bar.querySelector<HTMLButtonElement>('[data-copy]')!;

		startPost(id);
		onChange(() => {
			const liked = isOn('like', id);
			const saved = isOn('save', id);
			likeBtn.setAttribute('aria-pressed', String(liked));
			likeBtn.querySelector('[data-like-count]')!.textContent = String(likeCount(id, base));
			saveBtn.setAttribute('aria-pressed', String(saved));
			saveBtn.querySelector('[data-save-label]')!.textContent = saved ? 'Saved' : 'Save';
		});

		likeBtn.addEventListener('click', () => toggle('like', id));
		saveBtn.addEventListener('click', () => toggle('save', id));
		copyBtn.addEventListener('click', async () => {
			await copyLink(bar.dataset.url ?? location.href);
			copyBtn.classList.add('copied');
			setTimeout(() => copyBtn.classList.remove('copied'), 1500);
		});
	}
</script>

<style>
	.like-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 1.25rem;
		border: 1px solid var(--border);
		background: var(--card);
		color: var(--muted-foreground);
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 600;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: all 0.15s;
	}
	.like-btn:hover,
	.like-btn[aria-pressed='true'] {
		border-color: #f87171;
		background: rgb(254 242 242);
		color: #ef4444;
	}
	:global(.dark) .like-btn:hover,
	:global(.dark) .like-btn[aria-pressed='true'] {
		background: rgb(239 68 68 / 0.12);
	}
	.like-btn[aria-pressed='true'] svg {
		fill: currentColor;
	}

	.save-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--muted-foreground);
		cursor: pointer;
	}
	.save-btn:hover {
		color: var(--foreground);
	}
	.save-btn[aria-pressed='true'] {
		color: var(--primary);
	}
	.save-btn[aria-pressed='true'] svg {
		fill: currentColor;
	}

	.square-btn {
		display: inline-flex;
		height: 2.25rem;
		width: 2.25rem;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--border);
		background: var(--card);
		color: var(--muted-foreground) !important;
		cursor: pointer;
		transition: all 0.15s;
	}
	.square-btn:hover {
		border-color: var(--primary);
		color: var(--primary) !important;
	}
	.square-btn.copied {
		border-color: var(--primary);
		background: var(--primary);
		color: var(--primary-foreground) !important;
	}
</style>

---
// /preview/?token=…: shows a draft (or any post) exactly as it will look, before it's published.
// The admin's Preview button opens this with a one-hour token; the page fetches the post from
// the API in the browser and renders it with the blog's own post header and article styles.
// Hidden from search engines, and blocked in robots.txt.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const api = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Preview — ${SITE_TITLE}`} description="Draft preview." noindex />
	</head>
	<body>
		<Header />

		<!-- Preview banner: always visible, so a preview is never mistaken for the live post -->
		<div class="sticky top-[56px] z-40 border-b border-brand-gold/40 bg-brand-gold text-black">
			<div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2 text-[16px] sm:px-6">
				<p class="!m-0 font-semibold">
					Preview · <span data-preview-status>Loading…</span>
				</p>
				<p class="!m-0 opacity-80" data-preview-note>Not visible to readers.</p>
			</div>
		</div>

		<article data-preview data-api={api} hidden>
			<!-- Same hero as a real post (src/layouts/BlogPost.astro) -->
			<header class="relative flex min-h-[340px] items-end overflow-hidden bg-brand-ink text-white md:min-h-[460px]">
				<img data-p="cover" alt="" class="absolute inset-0 h-full w-full !rounded-none object-cover opacity-70" hidden />
				<div class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-black/10"></div>
				<div class="relative mx-auto w-full max-w-7xl px-4 pb-10 pt-24 sm:px-6">
					<p class="label !mb-4 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[16px]" data-p="terms"></p>
					<h1 class="!mb-5 max-w-3xl font-display !text-4xl font-medium uppercase !leading-[1] tracking-[-0.5px] !text-white sm:!text-5xl md:!text-[56px]" data-p="title"></h1>
					<p class="label !m-0 flex flex-wrap items-center gap-x-3 gap-y-1 text-[16px] text-white/65">
						<span class="font-logo text-[16px] font-bold tracking-tight text-white">Joel Green<span class="text-brand-logo-accent">.</span></span>
						<span aria-hidden="true">·</span>
						<span data-p="date"></span>
						<span aria-hidden="true">·</span>
						<span data-p="read"></span>
					</p>
				</div>
			</header>
			<p class="mx-auto !mb-0 w-full max-w-7xl px-4 pt-2 text-right text-[13px] italic text-muted-foreground sm:px-6" data-p="photo" hidden></p>

			<main class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6">
				<p class="!mb-8 font-heading text-[19px] leading-snug text-muted-foreground" data-p="excerpt" hidden></p>
				<div class="prose article-body" data-p="body"></div>
			</main>
		</article>

		<main class="mx-auto max-w-2xl px-4 py-24 text-center" data-preview-error hidden>
			<h1 class="font-display !text-[40px] font-semibold uppercase">Preview unavailable</h1>
			<p class="text-[16px] text-muted-foreground" data-p="error"></p>
		</main>

		<Footer />

		<script>
			// Two ways in:
			//  - #token=…   a saved post, fetched from the API (link copied in the admin; works for an hour)
			//  - ?live      unsaved text sent from the admin's editor (Preview button); updates as you type.
			//               Only after a token handshake with the admin (below), since posts can contain HTML.
			import { marked } from 'marked';
			import { ADMIN_ORIGINS, SITE_TIMEZONE } from '../consts';
			import { termLabel } from '../lib/taxonomy';
			import { photoCaption } from '../lib/rehypeImageCaptions.mjs';

			type PreviewPost = {
				title: string;
				subtitle?: string | null;
				excerpt?: string | null;
				content?: string | null;
				coverImage?: string | null;
				coverImageAlt?: string | null;
				coverImageCredit?: string | null;
				category?: string | null;
				tags?: string[] | null;
				status?: string;
				publishedAt?: string | null;
			};

			const article = document.querySelector<HTMLElement>('[data-preview]')!;
			const errorBox = document.querySelector<HTMLElement>('[data-preview-error]')!;
			const status = document.querySelector<HTMLElement>('[data-preview-status]')!;
			const note = document.querySelector<HTMLElement>('[data-preview-note]')!;
			const $ = (k: string) => document.querySelector<HTMLElement>(`[data-p="${k}"]`)!;
			const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

			const fail = (message: string) => {
				status.textContent = 'not available';
				$('error').textContent = message;
				errorBox.hidden = false;
				article.hidden = true;
			};

			/** Fill the page with a post, using the same pieces as a real post page */
			function render(p: PreviewPost, label: string) {
				document.title = `Preview: ${p.title || 'Untitled'} — The Creative Panel`;
				status.textContent = label;
				$('title').textContent = p.title || 'Untitled';
				const tags = Array.isArray(p.tags) ? p.tags : [];
				$('terms').innerHTML =
					(p.category ? `<span class="border border-brand-teal-light/60 px-2 py-0.5 text-white">${esc(termLabel(p.category))}</span>` : '') +
					tags.map((t) => `<span class="text-brand-teal-light">#${esc(termLabel(t))}</span>`).join('');
				const when = p.publishedAt ? new Date(p.publishedAt) : null;
				$('date').textContent =
					when && !isNaN(+when)
						? `${when > new Date() ? 'Scheduled for' : 'Posted'} ${when.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: SITE_TIMEZONE })}`
						: 'Not scheduled yet';
				const words = String(p.content ?? '').trim().split(/\s+/).filter(Boolean).length;
				$('read').textContent = `${Math.max(1, Math.round(words / 230))} min read`;
				const cover = $('cover') as HTMLImageElement;
				cover.hidden = !p.coverImage;
				if (p.coverImage && cover.getAttribute('src') !== p.coverImage) cover.src = p.coverImage;
				cover.alt = p.coverImageAlt?.trim() || p.title;
			const heroCaption = p.coverImage ? photoCaption(p.coverImageCredit) : null;
			$('photo').textContent = heroCaption ?? '';
			$('photo').hidden = !heroCaption;
				const excerpt = p.excerpt || p.subtitle;
				$('excerpt').textContent = excerpt ?? '';
				$('excerpt').hidden = !excerpt;
				// "# Heading" becomes h2, like real posts (the title is the page's only h1)
				$('body').innerHTML = (marked.parse(String(p.content ?? ''), { async: false }) as string).replace(/<(\/?)h1\b/g, '<$1h2');
			// "Photo: …" captions, like real posts (src/lib/rehypeImageCaptions.mjs)
			$('body').querySelectorAll('p').forEach((para) => {
				const only = para.children.length === 1 && !para.textContent?.trim() ? para.children[0] : null;
				const img = only?.tagName === 'IMG' ? only : only?.tagName === 'A' && only.children.length === 1 && only.children[0].tagName === 'IMG' ? only.children[0] : null;
				const caption = img && photoCaption(img.getAttribute('title'));
				if (!only || !caption) return;
				const figure = document.createElement('figure');
				figure.className = 'post-figure';
				const figcaption = document.createElement('figcaption');
				figcaption.textContent = caption;
				figure.append(only, figcaption);
				para.replaceWith(figure);
			});
				errorBox.hidden = true;
				article.hidden = false;
			}

			const params = new URLSearchParams(location.search);
			const api = article.dataset.api;
			/** POST JSON to the API; throws the API's message on failure */
			const post = async (path: string, body: unknown) => {
				const res = await fetch(`${api}${path}`, { method: 'POST', cache: 'no-store', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(data.message || `Couldn't load the preview (HTTP ${res.status}).`);
				return data;
			};
			// Copied links carry the token after "#" (never sent to servers); older ?token= links still work
			const token = new URLSearchParams(location.hash.slice(1)).get('token') ?? params.get('token');
			// The admin window that opened this one (the Preview button)
			const editor: Window | null = window.opener;

			if (token) {
				// Saved version, from the API
				note.textContent = 'Only people with this link can see it. It works for an hour after it was copied.';
				post('/content/preview', { token })
					.then((p: PreviewPost) =>
						render(p, p.status === 'PUBLISHED' ? 'published post (last saved version)' : p.status === 'ARCHIVED' ? 'archived, not on the site' : 'draft (last saved version)'),
					)
					.catch((e: Error) => fail(e.message));
			} else if (params.has('live') && editor) {
				// Unsaved text from the admin's editor, behind a handshake:
				//  1. this page makes a one-time code and asks the admin window for proof
				//  2. the admin answers with the code + a short token only a signed-in admin can get
				//  3. the API confirms the token; only then is text accepted, and only from that window,
				//     on an admin address, carrying the same code
				note.textContent = 'Live from the editor: nothing is saved or published. Changes appear as you type.';
				status.textContent = 'confirming with the admin…';
				let nonce = '';
				let trusted: string | null = null; // the admin address that passed the handshake
				let pending: PreviewPost | null = null; // text that arrived while the token was being checked
				let renewal = 0;

				const handshake = () => {
					nonce = crypto.randomUUID();
					// The code is useless without a valid token, so any admin address may receive it
					for (const origin of ADMIN_ORIGINS) editor.postMessage({ type: 'preview-ready', nonce }, origin);
				};

				addEventListener('message', async (e: MessageEvent) => {
					if (e.source !== editor || !ADMIN_ORIGINS.includes(e.origin) || e.data?.nonce !== nonce) return;
					if (e.data.type === 'preview-auth' && typeof e.data.token === 'string') {
						try {
							const { expiresAt } = await post('/content/preview/live/verify', { token: e.data.token });
							trusted = e.origin;
							// Ask for a fresh token a minute before this one runs out
							clearTimeout(renewal);
							renewal = window.setTimeout(handshake, Math.max(60_000, expiresAt - Date.now() - 60_000));
							if (pending) render(pending, 'unsaved changes from the editor');
							else status.textContent = 'waiting for the editor…';
							pending = null;
						} catch (err) {
							trusted = null;
							fail((err as Error).message);
						}
					} else if (e.data.type === 'preview-post' && e.data.post) {
						if (trusted === e.origin) render(e.data.post as PreviewPost, 'unsaved changes from the editor');
						else if (!trusted) pending = e.data.post as PreviewPost; // shown once the token checks out
					}
				});
				handshake();
			} else {
				fail('Open a preview from the post editor in the admin (Preview button).');
			}
		</script>
	</body>
</html>

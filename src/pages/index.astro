---
// The magazine homepage.
// Everything in this "frontmatter" block runs at BUILD time (not in the browser):
// we load the collections here and pass the data into components as props.
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AdSlot from '../components/AdSlot.astro';
import AboutCard from '../components/home/AboutCard.astro';
import PressContactCards from '../components/home/PressContactCards.astro';
import RssCard from '../components/home/RssCard.astro';
import BookHero from '../components/home/BookHero.astro';
import BooksRail from '../components/home/BooksRail.astro';
import FeaturedCard from '../components/home/FeaturedCard.astro';
import NewsletterBar from '../components/home/NewsletterBar.astro';
import MostRead from '../components/home/MostRead.astro';
import PostList from '../components/home/PostList.astro';
import PostRow from '../components/home/PostRow.astro';
import SectionTitle from '../components/home/SectionTitle.astro';
import PostingSchedule from '../components/PostingSchedule.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sortByDate } from '../lib/posts';
import { tagIndex } from '../lib/taxonomy';
import { abs } from '../lib/seo';
import { getAllStats } from '../lib/stats';

const posts = sortByDate(await getCollection('blog'));
const books = (await getCollection('books')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const heroBook = books.find((b) => b.data.featured) ?? books[0];
const featured = posts.filter((p) => p.data.featured).slice(0, 2);
const latest = posts.filter((p) => !featured.includes(p));
const tags = tagIndex(posts);

// Most Liked / You might also like: ranked by API counts; newest first until counts exist.
const stats = await getAllStats();

// SEO: the homepage describes the blog and lists its newest posts
const seoDescription =
	'Essays, chapters and writing notes from Joel Green, who is writing The Halo, a near-future sci-fi thriller. Worldbuilding, craft and the story behind the stories.';
const schema = [
	{
		'@type': 'Blog',
		'@id': abs('/#blog'),
		url: abs('/'),
		name: SITE_TITLE,
		description: seoDescription,
		author: { '@id': abs('/about/#joel-green') },
		blogPost: posts.slice(0, 10).map((p) => ({
			'@type': 'BlogPosting',
			headline: p.data.title,
			url: abs(`/blog/${p.id}/`),
			datePublished: p.data.pubDate.toISOString(),
		})),
	},
];
// (fallback: newest first for likes, oldest first for views, so the two lists differ)
const rank = (key: 'likes' | 'views') => {
	const score = (id: string) => stats[id]?.[key] ?? 0;
	if (posts.some((p) => score(p.id) > 0)) return [...posts].sort((a, b) => score(b.id) - score(a.id));
	return key === 'likes' ? posts : [...posts].reverse();
};
// Most Read, Most Liked and You might also like only show once there are enough posts:
// with fewer, they just repeat the same stories as Latest
const RANKINGS_FROM = 10;
const showRankings = posts.length >= RANKINGS_FROM;
const mostLiked = rank('likes').slice(0, 3);
const alsoLike = rank('views').filter((p) => !featured.includes(p)).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${SITE_DESCRIPTION}`} description={seoDescription} schema={schema} />
	</head>
	<body>
		<!-- The page heading for search engines and screen readers (the hero shows the featured book) -->
		<h1 class="sr-only">{SITE_TITLE}: {SITE_DESCRIPTION}</h1>
		<Header />
		{heroBook && <BookHero book={heroBook} />}
		<NewsletterBar />

		<main class="home">
			<!-- Left: books -->
			<aside class="order-2 lg:order-1">
				<!-- Sticky on desktop: stays in view under the header while the page scrolls -->
				<div class="lg:sticky lg:top-[80px]">
					<BooksRail books={books} />
				</div>
			</aside>

			<!-- Center: tags, latest, featured, most read, most liked / also like -->
			<div class="order-1 min-w-0 lg:order-2">
				<!-- Most-used tags (each opens its tag page), capped so the row never takes over the page -->
				{
					tags.length > 0 && (
						<nav aria-label="Tags" class="mb-8 flex flex-wrap items-center gap-1.5">
							{tags.slice(0, 8).map((t) => (
								<a href={`/tags/${t.slug}/`} class="tag-chip">
									#{t.label}
								</a>
							))}
							<a href="/tags/" class="ml-1 font-display text-[16px] font-semibold uppercase tracking-[0.08em] !text-primary no-underline hover:underline">
								All tags →
							</a>
						</nav>
					)
				}

				<section class="mb-12">
					<SectionTitle>Latest</SectionTitle>
					<ul class="!m-0 !p-0" role="list">
						{latest.map((post) => <PostRow post={post} />)}
					</ul>
					{
						posts.length === 0 ? (
							// Before the first post: say so, and point to the newsletter
							<p class="!mb-0 border border-dashed border-border px-6 py-8 text-[16px] leading-relaxed text-muted-foreground">
								The first essays and chapters are on their way. Subscribe to the newsletter above to get them first.
							</p>
						) : (
							<a href="/blog" class="label mt-6 inline-block !text-[16px] font-semibold">View the archive →</a>
						)
					}
				</section>

				{
					featured.length > 0 && (
						<section class="mb-12">
							<SectionTitle>Featured</SectionTitle>
							<div class="grid gap-px sm:grid-cols-2">
								{featured.map((post) => <FeaturedCard post={post} />)}
							</div>
						</section>
					)
				}

				{
					showRankings && (
						<>
							<MostRead posts={posts} />
							<div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-6">
								<PostList title="Most Liked" icon="heart" meta="likes" posts={mostLiked} />
								<PostList title="You might also like" icon="sparkle" meta="views" posts={alsoLike} />
							</div>
						</>
					)
				}
			</div>

			<!-- Right: about -->
			<aside class="order-3 flex flex-col gap-6">
				<AboutCard />
				<PressContactCards />
				<!-- When new posts go out (POSTING_SCHEDULE in consts.ts) -->
				<PostingSchedule />
				<!-- AdSense: right sidebar -->
				<AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_HOME_SIDEBAR} format="vertical" minHeight={600} small />
				<!-- Sticky on desktop once you scroll past the cards above -->
				<div class="lg:sticky lg:top-[80px]">
					<RssCard />
				</div>
			</aside>
		</main>

		<!-- The newsletter bar sits under the hero, so the footer doesn't offer it again -->
		<Footer newsletter={false} />

		<script>
			// Live like/view counts from the API (hearts, Most Read, Most Liked)
			import { refreshStats } from '../lib/liveStats';
			refreshStats();
		</script>

		<style>
			/* Prototype grid: 220px | content | 220px, ~36px gutters, 77rem max */
			main.home {
				display: grid;
				gap: 2.5rem;
				width: 100%;
				max-width: 77rem;
				padding: 2.5rem 1rem 4rem;
			}
			@media (min-width: 640px) {
				main.home {
					padding-inline: 1.5rem;
				}
			}
			@media (min-width: 1024px) {
				main.home {
					grid-template-columns: 220px minmax(0, 1fr) 220px;
					gap: 2.25rem;
					padding-inline: 2.25rem;
				}
			}
		</style>
	</body>
</html>

---
// /links: the page for social media bios ("link in bio"). One page that always shows the newest post,
// plus the newsletter, books and everything else, so a single bio link never goes stale.
// Each platform's bio uses its own tagged address (admin → Promote → Bio links), e.g.
//   https://joelgreen.studio/links/?utm_source=instagram&utm_medium=social
// so the Traffic page shows which bio sends readers. Kept out of search results (it repeats other pages).
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PostImage from '../components/PostImage.astro';
import PostingSchedule from '../components/PostingSchedule.astro';
import { SITE_TITLE } from '../consts';
import { profile } from '../data/profile';
import { formatDate, readingTime, sortByDate } from '../lib/posts';
import { relFor } from '../lib/rehypeNofollow.mjs';
import { termLabel } from '../lib/taxonomy';

const [latest, ...older] = sortByDate(await getCollection('blog'));
const recent = older.slice(0, 3);
const books = (await getCollection('books')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.sortOrder - b.data.sortOrder);
const book = books[0];
const initials = profile.name.split(' ').map((w) => w[0]).join('').slice(0, 2);
const apiUrl = import.meta.env.PUBLIC_API_URL ?? '';

const buttons = [
	{ href: '/latest/', label: 'All the latest posts' },
	...(book ? [{ href: book.data.link || '/books/', label: `${book.data.title}${book.data.status ? ` · ${book.data.status}` : ''}` }] : []),
	{ href: 'https://joelgreenauthor.com', label: 'Author website', external: true },
	{ href: '/about/', label: 'About me' },
	{ href: '/rss/', label: 'Follow by RSS' },
	...profile.socials.map((s) => ({ href: s.url, label: s.label, external: true })),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Links — ${SITE_TITLE}`} description={`The latest from ${profile.name}: new posts, the newsletter and books.`} noindex />
	</head>
	<body class="min-h-screen bg-background">
		<main class="mx-auto w-full max-w-md px-4 pb-16 pt-10">
			<!-- Who -->
			<header class="text-center">
				{
					profile.avatar ? (
						<img src={profile.avatar} alt={profile.name} width="88" height="88" class="mx-auto size-22 !rounded-full object-cover" />
					) : (
						<span class="mx-auto flex size-22 items-center justify-center bg-brand-ink font-display text-[32px] font-semibold text-brand-gold" aria-hidden="true">
							{initials}
						</span>
					)
				}
				<a href="/" class="mt-4 inline-block font-logo text-[22px] font-bold uppercase leading-none tracking-tight no-underline">
					<span class="text-brand-gold">{SITE_TITLE}</span><span class="text-brand-logo-accent">.</span>
				</a>
				<p class="!mb-0 mt-2 text-[16px] text-muted-foreground">The writings of {profile.name}. {profile.bio}</p>
			</header>

			<!-- Newest post, big -->
			{
				latest && (
					<section class="mt-8" aria-labelledby="links-latest">
						<p id="links-latest" class="label !mb-2 !text-[14px] font-semibold text-primary">
							Newest post
						</p>
						<a href={`/blog/${latest.id}/`} class="group block border border-border bg-card no-underline transition-colors hover:border-primary">
							<div class="relative aspect-[16/9] overflow-hidden bg-brand-ink">
								<PostImage
									src={latest.data.heroImage}
									alt={latest.data.heroImageAlt || latest.data.title}
									fallback={latest.data.category ?? ''}
									width={800}
									class="absolute inset-0 h-full w-full !rounded-none object-cover transition duration-500 group-hover:scale-[1.03]"
								/>
							</div>
							<div class="p-4">
								<p class="label !mb-1 !text-[13px] text-muted-foreground">
									{termLabel(latest.data.category)} · {formatDate(latest.data.pubDate)} · {readingTime(latest)} min read
								</p>
								<h1 class="!m-0 font-display !text-[26px] font-semibold uppercase !leading-[1.05] !text-foreground group-hover:!text-primary">{latest.data.title}</h1>
								{latest.data.description && <p class="!mb-0 mt-2 line-clamp-3 text-[15px] text-muted-foreground">{latest.data.description}</p>}
							</div>
						</a>
					</section>
				)
			}

			<!-- A few more -->
			{
				recent.length > 0 && (
					<section class="mt-6" aria-labelledby="links-recent">
						<p id="links-recent" class="label !mb-2 !text-[14px] font-semibold text-muted-foreground">
							Recent
						</p>
						<ul class="!m-0 divide-y divide-border border border-border !p-0" role="list">
							{recent.map((p) => (
								<li class="list-none">
									<a href={`/blog/${p.id}/`} class="flex items-center justify-between gap-3 px-4 py-3 no-underline hover:bg-muted">
										<span class="min-w-0 truncate text-[16px] font-medium !text-foreground">{p.data.title}</span>
										<span class="shrink-0 text-[13px] text-muted-foreground">{formatDate(p.data.pubDate)}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<!-- Newsletter: the main thing a bio visitor can do -->
			<section class="mt-6 border border-border bg-card p-4" data-newsletter-root aria-labelledby="links-newsletter">
				<p id="links-newsletter" class="label !mb-1 !text-[16px] font-semibold text-foreground">Get every new post by email</p>
				<p class="!mb-3 text-[15px] text-muted-foreground">New chapters, writing notes &amp; behind-the-scenes. No noise.</p>
				<form class="flex w-full" data-newsletter data-api={apiUrl}>
					<label for="links-email" class="sr-only">Email address</label>
					<input
						id="links-email"
						type="email"
						name="email"
						required
						placeholder="your@email.com"
						class="w-full min-w-0 border border-input bg-muted px-3 py-2.5 text-sm outline-none focus:border-primary"
					/>
					<button type="submit" class="label shrink-0 bg-primary px-4 !text-[15px] !font-semibold text-primary-foreground hover:opacity-90">Subscribe</button>
				</form>
				<p class="!mb-0 mt-2 text-sm" data-newsletter-status role="status" hidden></p>
				<PostingSchedule variant="line" class="!mb-0 mt-3 !text-[14px]" />
			</section>

			<!-- Everything else -->
			<nav class="mt-6 flex flex-col gap-2" aria-label="More links">
				{
					buttons.map((b) => (
						<a
							href={b.href}
							class="block border border-border px-4 py-3 text-center font-display text-[16px] font-semibold uppercase tracking-[0.06em] !text-foreground no-underline transition-colors hover:border-primary hover:!text-primary"
							{...('external' in b && b.external ? { target: '_blank', rel: relFor(b.href, 'noopener') } : {})}
						>
							{b.label}
						</a>
					))
				}
			</nav>

			<p class="!mb-0 mt-10 text-center text-[13px] text-muted-foreground">
				<a href="/" class="!text-muted-foreground hover:!text-primary">joelgreen.studio</a> · <a href="/privacy/" class="!text-muted-foreground hover:!text-primary">Privacy</a> ·{' '}
				<button type="button" data-cookie-settings class="cursor-pointer text-muted-foreground hover:text-primary">Cookie settings</button>
			</p>
		</main>

		<CookieConsent />

		<script>
			import { initNewsletterForms } from '../lib/newsletter';
			import { rememberEntry } from '../lib/viewSource';
			initNewsletterForms();
			rememberEntry(); // a bio visit (?utm_source=instagram…) is credited to that platform when a post is opened
		</script>
	</body>
</html>

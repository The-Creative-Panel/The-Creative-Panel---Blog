# Response headers for Cloudflare static assets (see wrangler.jsonc)

# Build files have a content hash in their name, so they can be cached forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else: basic security headers (pages themselves revalidate on each visit)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Draft preview page: never indexed, and preview links (which carry a token) aren't passed on to other sites
/preview/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
